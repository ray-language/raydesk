// Domain model: the Todo type and its JSON (de)serialization. Pure data — no
// I/O, no persistence (that lives in `store`, backed by std/kv).

import std/json;

pub struct Todo {
    id: string,
    title: string,
    done: bool,
    created_ms: int,
}

// --- JSON: one Todo <-> a JSON object string (the kv value) ---

fn todo_to_json(t: Todo) -> json.Json {
    var m: Map<string, json.Json> = Map.new();
    m.insert("id", json.Json.JStr(t.id));
    m.insert("title", json.Json.JStr(t.title));
    m.insert("done", json.Json.JBool(t.done));
    m.insert("created_ms", json.Json.JNum(t.created_ms as float));
    json.Json.JObject(m)
}

pub fn todo_to_json_str(t: Todo) -> string {
    json.stringify(todo_to_json(t))
}

fn jstr(j: json.Json, key: string) -> string {
    match (j) {
        json.Json.JObject(m) => match (get(m, key)) {
            Option.Some(v) => match (v) {
                json.Json.JStr(s) => s,
                _ => "",
            },
            Option.None => "",
        },
        _ => "",
    }
}

fn jbool(j: json.Json, key: string) -> bool {
    match (j) {
        json.Json.JObject(m) => match (get(m, key)) {
            Option.Some(v) => match (v) {
                json.Json.JBool(b) => b,
                _ => false,
            },
            Option.None => false,
        },
        _ => false,
    }
}

fn jnum(j: json.Json, key: string) -> int {
    match (j) {
        json.Json.JObject(m) => match (get(m, key)) {
            Option.Some(v) => match (v) {
                json.Json.JNum(n) => n as int,
                _ => 0,
            },
            Option.None => 0,
        },
        _ => 0,
    }
}

pub fn todo_from_json_str(src: string) -> Option<Todo> {
    match (json.parse(src)) {
        Result.Ok(v) => match (v) {
            json.Json.JObject(_m) => Option.Some(Todo {
                id: jstr(v, "id"),
                title: jstr(v, "title"),
                done: jbool(v, "done"),
                created_ms: jnum(v, "created_ms"),
            }),
            _ => Option.None,
        },
        Result.Err(_) => Option.None,
    }
}

// The whole list as a JSON array — the API response shape.
pub fn todos_to_json(todos: [Todo]) -> string {
    let items = todos.map(fn(t: Todo) -> json.Json { todo_to_json(t) });
    json.stringify(json.Json.JArray(items))
}

// Extracts a top-level string field from a JSON object body ({"title": …} /
// {"id": …}). "" when absent or invalid.
pub fn field_of(source: string, key: string) -> string {
    match (json.parse(source)) {
        Result.Ok(v) => jstr(v, key),
        Result.Err(_) => "",
    }
}

// --- Tests ---

@test
fn todo_json_roundtrip() {
    let t = Todo { id: "01x", title: "café ☕", done: true, created_ms: 42 };
    match (todo_from_json_str(todo_to_json_str(t))) {
        Option.Some(u) => {
            assert_eq(u.id, "01x");
            assert_eq(u.title, "café ☕");
            assert_eq(u.done, true);
            assert_eq(u.created_ms, 42);
        },
        Option.None => panic("should parse"),
    }
}

@test
fn bad_json_is_none() {
    match (todo_from_json_str("not json")) {
        Option.Some(_t) => panic("should be None"),
        Option.None => {},
    }
}

@test
fn list_json() {
    let ts = [
        Todo { id: "a", title: "x", done: false, created_ms: 1 },
        Todo { id: "b", title: "y", done: true, created_ms: 2 },
    ];
    let s = todos_to_json(ts);
    assert(s.contains("\"id\":\"a\""));
    assert(s.contains("\"done\":true"));
}

@test
fn field_extraction() {
    assert_eq(field_of("{\"title\":\"hola\"}", "title"), "hola");
    assert_eq(field_of("{\"id\":\"x1\"}", "id"), "x1");
    assert_eq(field_of("not json", "title"), "");
}
