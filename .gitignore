# raylang build artifacts
/target/
/dist/
*.app/
.ray-deps/

# Native build output (binary named after the entry file's stem)
/raydesk
/main

# Local runtime state
*.kv

# macOS
.DS_Store

# Xcode / iOS shell (raydesk-ios/, generated by `ray bundle --ios`)
# Compiled staticlibs of the raylang program — regenerate with `ray bundle --ios`.
raydesk-ios/libs/
raydesk-ios/libs-sim/
# User-specific Xcode state (never shared).
**/xcuserdata/
*.xcuserstate
# Xcode build output.
DerivedData/
build/

# Node / Tailwind build
node_modules/

# Android shell (raydesk-android/, generated by `ray bundle --android`)
raydesk-android/.gradle/
raydesk-android/build/
raydesk-android/app/build/
raydesk-android/local.properties
# Compiled raylang program (regenerate with `ray bundle --android`)
raydesk-android/app/src/main/jniLibs/**/*.so
