// RayDesk — a small desktop task manager written in raylang.
//
// A native window (std/ui, system webview) shows the frontend (assets/), which is
// served over a tiny local HTTP server (the `web` framework + web.static_embedded,
// bundle-safe). The server is locked to that ONE window with web.listen_local: the
// window opens with `?ray_token=<token>` (a fresh 128-bit token per launch), and any
// other process on the machine, or any web page in the user's browser, gets 403.
// (ray://app + ui.mount_embed would need no port at all, but the iOS/Android shells
// load the UI from this same local server.) Everything else — the DATA channel — goes over std/ui's built-in
// IPC bridge (M152): the page calls `window.ray.send(json)`, raylang handles it in
// the event loop as a "message" event, mutates the std/kv store, and pushes the
// new state back with `eval_js(window.rayRender(...))`. No HTTP JSON API.
//
// State: the std/kv store is opened ONCE and owned by this event-loop fiber (the
// only one that touches it), so there is no per-request reopen and no shared-state
// race — the web fiber only serves static files.

import std/ui;
import std/fs;
import std/kv;
import model;
import store;
import frontend;

const APP_TITLE: string = "RayDesk";

const WIN_W: int = 920;

const WIN_H: int = 660;

// Pushes the current task list to the page (the page defines window.rayRender).
// Used for backend-initiated updates (menus) and the fire-and-forget fallback.
fn push_state(win: int, s: kv.Store) -> unit {
    let json = model.todos_to_json(store.list(s));
    let _e = ui.eval_js(win, "window.rayRender && window.rayRender(${json})");
}

// Handles one IPC message. `window.ray.request(cmd)` arrives as a request (M157):
// apply it and RESOLVE its Promise with the updated list via `reply`. A plain
// `window.ray.send(cmd)` (fallback for older shells) has no id, so we push the
// state instead.
fn handle_message(win: int, s: kv.Store, ev: ui.UiEvent) -> unit {
    match (ui.as_request(ev)) {
        Option.Some(req) => {
            store.apply(s, req.1);
            let _r = ui.reply(ev.window, req.0, model.todos_to_json(store.list(s)));
        },
        Option.None => {
            store.apply(s, ev.tag);
            push_state(win, s);
        },
    }
}

// --- Menus (std/ui) ---

fn install_menus() -> unit {
    let _s = ui.set_about(
        "RayDesk",
        "0.2.0",
        "Gestor de tareas de escritorio y móvil",
        "© 2026 Rayala · Hecho con raylang"
    );
    let _a = ui.app_menu("RayDesk", [ui.item("role:about", "Acerca de RayDesk", "")]);
    let _f = ui.menu(
        "Archivo",
        [
            ui.item("new", "Nueva tarea", "N"),
            ui.item("export", "Exportar tareas…", "E"),
            ui.item("reload", "Recargar", "R")
        ]
    );
    let _t = ui.menu("Tarea", [ui.item("clear", "Limpiar completadas", "K")]);
}

fn export_tasks(s: kv.Store) -> unit {
    var o = ui.file_options();
    o.title = "Exportar tareas";
    o.suggested = "raydesk-tareas.json";
    o.filters = [ui.filter("JSON", ["json"])];
    match (ui.save_file_with(o)) {
        Result.Ok(chosen) => match (chosen) {
            Option.Some(path) => {
                match (fs.write_file(path, model.todos_to_json(store.list(s)))) {
                    Result.Ok(_n) => { },
                    Result.Err(e) => eprint("RayDesk: export failed: ${e}"),
                }
            },
            Option.None => { },
        },
        Result.Err(e) => eprint("RayDesk: save dialog failed: ${e}"),
    }
}

fn on_menu(win: int, s: kv.Store, tag: string) -> unit {
    if (tag == "role:about") {
        // Reached only on Linux (macOS opens the native About panel, no event).
        let _e = ui.eval_js(win, "window.rayShowAbout && window.rayShowAbout();");
    } else if (tag == "new") {
        let _e = ui.eval_js(win, "var e=document.getElementById('title'); if(e){e.focus();}");
    } else if (tag == "reload") {
        push_state(win, s);
    } else if (tag == "clear") {
        store.clear_done(s);
        push_state(win, s);
    } else if (tag == "export") {
        export_tasks(s);
    }
}

fn main() -> int {
    let s = match (store.open()) {
        Result.Ok(handle) => handle,
        Result.Err(e) => {
            eprint("RayDesk: cannot open store: ${e}");
            return 1;
        },
    };

    let url = match (frontend.start(frontend.new_token())) {
        Result.Ok(u) => u,
        Result.Err(e) => {
            eprint("RayDesk: cannot start the local server: ${e}");
            return 1;
        },
    };

    install_menus();

    let win = match (ui.open(APP_TITLE, url, WIN_W, WIN_H)) {
        Result.Ok(w) => w,
        Result.Err(e) => {
            eprint("RayDesk: cannot open window: ${e}");
            return 1;
        },
    };

    while (true) {
        match (ui.next_event()) {
            Result.Ok(ev) => {
                if (ev.kind == "closed") {
                    exit(0);
                } else if (ev.kind == "menu") {
                    on_menu(win, s, ev.tag);
                } else if (ev.kind == "message") {
                    handle_message(win, s, ev);
                }
            },
            Result.Err(e) => {
                eprint("RayDesk: ui event error: ${e}");
                exit(1);
            },
        }
    }
    0
}
