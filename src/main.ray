// RayDesk — a small desktop task manager written in raylang.
//
// A native window (std/ui, system webview) loads a local HTTP backend built on
// the `web` framework (Express-style routing over net/webserver, the recommended
// base for std/ui app backends). The frontend (assets/) is served straight from
// the embedded bundle with `web.static_embedded` (live disk in dev, baked into
// the native binary / .app). Request handlers are stateless — the JSON file in
// `store` is the source of truth — which keeps shared mutable state out of the
// per-connection fibers.
//
// Note on verbs: the web framework serves GET/HEAD from the static mount FIRST
// (so a "/" mount can't be shadowed by a route), and lets POST under the mount
// reach routing. RayDesk therefore mounts the assets at "/" and exposes the API
// as POST endpoints — including the read (`/api/list`).

import web/framework as web;
import std/ui;
import std/net;
import std/fs;
import model;
import store;

const APP_TITLE: string = "RayDesk";
const WIN_W: int = 920;
const WIN_H: int = 660;

// --- API handlers: thin wrappers over the std/kv-backed `store` repository ---

fn api_list(c: web.Ctx, r: web.Res) -> unit {
    web.json(r, model.todos_to_json(store.list()));
}

fn api_add(c: web.Ctx, r: web.Res) -> unit {
    let title = model.field_of(web.body(c), "title").trim();
    let todos = if (title.len() > 0) { store.add(title) } else { store.list() };
    web.json(r, model.todos_to_json(todos));
}

fn api_toggle(c: web.Ctx, r: web.Res) -> unit {
    let todos = store.toggle(model.field_of(web.body(c), "id"));
    web.json(r, model.todos_to_json(todos));
}

fn api_delete(c: web.Ctx, r: web.Res) -> unit {
    let todos = store.remove(model.field_of(web.body(c), "id"));
    web.json(r, model.todos_to_json(todos));
}

fn api_clear(c: web.Ctx, r: web.Res) -> unit {
    web.json(r, model.todos_to_json(store.clear_done()));
}

fn build() -> web.App {
    let app = web.new_app();
    web.POST(app, "/api/list", api_list);
    web.POST(app, "/api/add", api_add);
    web.POST(app, "/api/toggle", api_toggle);
    web.POST(app, "/api/delete", api_delete);
    web.POST(app, "/api/clear-done", api_clear);
    // Serves index.html at "/", plus /app.css and /app.js, from the [native]
    // embed bundle. Path traversal ("..") is rejected by the framework.
    web.static_embedded(app, "/", "assets");
    app
}

// --- Menus (std/ui) ---
//
// Custom top-level menus. A click emits a "menu" event whose `tag` we act on in
// the event loop. Actions drive the frontend through `ui.eval_js` (the raylang ->
// JS bridge), reusing the page's own handlers so the UI stays in sync; "export"
// uses the native save dialog. The standard App/Edit menus (⌘Q, clipboard, undo)
// install themselves. On Linux the menu bar is per-window, so register BEFORE
// opening the window.
fn install_menus() -> unit {
    // "Acerca de RayDesk" in the APPLICATION menu (macOS: the bold first menu,
    // above Hide/Quit). Passing the name also retitles it to "RayDesk" even under
    // `ray run` (where it would show the process name "ray"). A normal tag emits a
    // "menu" event, so About opens our own modal — consistent on macOS and Linux.
    // (Use tag "role:about" instead to get the native macOS about panel, but that
    // fires no event, so it wouldn't show our modal.)
    let _a = ui.app_menu("RayDesk", [
        ui.MenuItem { tag: "about", title: "Acerca de RayDesk", shortcut: "" },
    ]);
    let _f = ui.menu("Archivo", [
        ui.MenuItem { tag: "new", title: "Nueva tarea", shortcut: "N" },
        ui.MenuItem { tag: "export", title: "Exportar tareas…", shortcut: "E" },
        ui.MenuItem { tag: "reload", title: "Recargar", shortcut: "R" },
    ]);
    let _t = ui.menu("Tarea", [
        ui.MenuItem { tag: "clear", title: "Limpiar completadas", shortcut: "K" },
    ]);
}

// Writes the current task list as JSON to a user-chosen path (native "save as").
fn export_tasks() -> unit {
    match (ui.save_file("raydesk-tareas.json")) {
        Result.Ok(chosen) => match (chosen) {
            Option.Some(path) => {
                match (fs.write_file(path, model.todos_to_json(store.list()))) {
                    Result.Ok(_n) => {},
                    Result.Err(e) => eprint("RayDesk: export failed: ${e}"),
                }
            },
            Option.None => {},
        },
        Result.Err(e) => eprint("RayDesk: save dialog failed: ${e}"),
    }
}

fn on_menu(win: int, tag: string) -> unit {
    if (tag == "about") {
        let _e = ui.eval_js(win, "window.rayShowAbout && window.rayShowAbout();");
    } else if (tag == "new") {
        let _e = ui.eval_js(win, "var e=document.getElementById('title'); if(e){e.focus();}");
    } else if (tag == "reload") {
        let _e = ui.eval_js(win, "location.reload();");
    } else if (tag == "clear") {
        let _e = ui.eval_js(win, "var b=document.getElementById('clear-done'); if(b){b.click();}");
    } else if (tag == "export") {
        export_tasks();
    }
}

fn main() -> int {
    // Bind first, learn the port, then serve on the same listener — no
    // close/re-bind race (web.listen_on, M150). The window opens on that port.
    let listener = match (net.tcp_listen("127.0.0.1", 0)) {
        Result.Ok(l) => l,
        Result.Err(e) => {
            eprint("RayDesk: cannot bind local server: ${e}");
            return 1;
        }
    };
    let port = net.local_port(listener);
    let url = "http://127.0.0.1:${port}/";

    let _server = spawn(fn() { let _r = web.listen_on(build, listener); });

    // Register menus before opening (Linux applies them to later windows).
    install_menus();

    let win = match (ui.open(APP_TITLE, url, WIN_W, WIN_H)) {
        Result.Ok(w) => w,
        Result.Err(e) => {
            eprint("RayDesk: cannot open window: ${e}");
            return 1;
        }
    };

    while (true) {
        match (ui.next_event()) {
            Result.Ok(ev) => {
                if (ev.kind == "closed") {
                    exit(0);
                } else if (ev.kind == "menu") {
                    on_menu(win, ev.tag);
                }
            },
            Result.Err(e) => {
                eprint("RayDesk: ui event error: ${e}");
                exit(1);
            }
        }
    }
    0
}
