// Persistence, backed by std/kv — a key/value store with atomic saves
// (temp + rename), one KEY PER TASK (the task id, a time-ordered uuid_v7, so
// `keys()` comes back in creation order).
//
// The store is opened ONCE (see `open`) and owned by the UI event-loop fiber,
// which is the only fiber that touches it — so there is no per-request reopen and
// no shared-state race (the web server fiber only serves static assets). This is
// the simplest correct model for a single-owner event loop; the actor form
// (`kv.open_shared`) is only needed when several fibers share the store.
//
// Location: `$HOME/Documents/RayDesk/tasks.kv`. On iOS the app container root
// (`$HOME`) is NOT writable — only subdirectories like `Documents/` are.

import std/kv;
import std/fs;
import std/uuid;
import std/time;
import model;

fn base_dir() -> string {
    match (env("HOME")) {
        Option.Some(h) => "${h}/Documents/RayDesk",
        Option.None => ".",
    }
}

fn store_path() -> string {
    "${base_dir()}/tasks.kv"
}

pub fn open() -> Result<kv.Store, string> {
    let _dir = fs.mkdir(base_dir());
    kv.open(store_path())
}

fn commit(s: kv.Store) -> unit {
    match (s.save()) {
        Result.Ok(_n) => {},
        Result.Err(e) => eprint("RayDesk: kv save failed: ${e}"),
    }
}

pub fn list(s: kv.Store) -> [model.Todo] {
    var out: [model.Todo] = [];
    for k in s.keys() {
        match (s.get_string(k)) {
            Option.Some(v) => match (model.todo_from_json_str(v)) {
                Option.Some(t) => out.push(t),
                Option.None => {},
            },
            Option.None => {},
        }
    }
    out
}

pub fn add(s: kv.Store, title: string) -> unit {
    let t = model.Todo {
        id: uuid.uuid_v7(),
        title: title,
        done: false,
        created_ms: time.now(),
    };
    s.set_string(t.id, model.todo_to_json_str(t));
    commit(s);
}

pub fn toggle(s: kv.Store, id: string) -> unit {
    match (s.get_string(id)) {
        Option.Some(v) => match (model.todo_from_json_str(v)) {
            Option.Some(t) => {
                let flipped = model.Todo {
                    id: t.id,
                    title: t.title,
                    done: !t.done,
                    created_ms: t.created_ms,
                };
                s.set_string(id, model.todo_to_json_str(flipped));
                commit(s);
            },
            Option.None => {},
        },
        Option.None => {},
    }
}

pub fn remove(s: kv.Store, id: string) -> unit {
    let _removed = s.delete(id);
    commit(s);
}

pub fn clear_done(s: kv.Store) -> unit {
    for k in s.keys() {
        match (s.get_string(k)) {
            Option.Some(v) => match (model.todo_from_json_str(v)) {
                Option.Some(t) => {
                    if (t.done) { let _r = s.delete(k); }
                },
                Option.None => {},
            },
            Option.None => {},
        }
    }
    commit(s);
}
