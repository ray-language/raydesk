// RayDesk — a small desktop task manager written in raylang.
//
// A native window (std/ui, system webview) loads a local HTTP backend built on
// the `web` framework (Express-style routing over net/webserver, the
// recommended base for std/ui app backends). The frontend (assets/) is served
// from the embedded bundle (std/embed) so a bundled .app runs from any cwd.
// Request handlers are stateless — the JSON file in `store` is the source of
// truth — which keeps shared mutable state out of the per-connection fibers.

import web/framework as web;
import std/ui;
import std/net;
import std/embed;
import model;
import store;

const APP_TITLE: string = "RayDesk";
const WIN_W: int = 920;
const WIN_H: int = 660;

fn content_type(path: string) -> string {
    if (path.ends_with(".html")) { "text/html; charset=utf-8" }
    else if (path.ends_with(".css")) { "text/css; charset=utf-8" }
    else if (path.ends_with(".js")) { "application/javascript; charset=utf-8" }
    else if (path.ends_with(".json")) { "application/json; charset=utf-8" }
    else if (path.ends_with(".svg")) { "image/svg+xml" }
    else if (path.ends_with(".png")) { "image/png" }
    else { "application/octet-stream" }
}

// --- API handlers (stateless: load -> mutate -> save -> respond) ---

fn api_list(c: web.Ctx, r: web.Res) -> unit {
    web.json(r, model.todos_to_json(store.load()));
}

fn api_add(c: web.Ctx, r: web.Res) -> unit {
    let title = model.field_of(web.body(c), "title").trim();
    var todos = store.load();
    if (title.len() > 0) { todos = model.add(todos, title); }
    let _s = store.save(todos);
    web.json(r, model.todos_to_json(todos));
}

fn api_toggle(c: web.Ctx, r: web.Res) -> unit {
    let id = model.field_of(web.body(c), "id");
    let todos = model.toggle(store.load(), id);
    let _s = store.save(todos);
    web.json(r, model.todos_to_json(todos));
}

fn api_delete(c: web.Ctx, r: web.Res) -> unit {
    let id = model.field_of(web.body(c), "id");
    let todos = model.remove(store.load(), id);
    let _s = store.save(todos);
    web.json(r, model.todos_to_json(todos));
}

fn api_clear(c: web.Ctx, r: web.Res) -> unit {
    let todos = model.clear_done(store.load());
    let _s = store.save(todos);
    web.json(r, model.todos_to_json(todos));
}

// --- Static assets from the embedded bundle (catch-all GET) ---

fn serve_asset(c: web.Ctx, r: web.Res) -> unit {
    let rest = web.param(c, "rest");
    let rel = if (rest == "") { "assets/index.html" } else { "assets/${rest}" };
    if (rel.contains("..")) {
        let _x = web.status(r, 403);
        web.text(r, "forbidden");
        return;
    }
    match (embed.read(rel)) {
        Result.Ok(data) => {
            r.body = data;
            r.content_type = content_type(rel);
        },
        Result.Err(_) => {
            let _x = web.status(r, 404);
            web.text(r, "not found");
        },
    }
}

fn build() -> web.App {
    let app = web.new_app();
    web.GET(app, "/api/tasks", api_list);
    web.POST(app, "/api/tasks", api_add);
    web.POST(app, "/api/toggle", api_toggle);
    web.POST(app, "/api/delete", api_delete);
    web.POST(app, "/api/clear-done", api_clear);
    web.GET(app, "/*rest", serve_asset);
    app
}

// Ask the OS for a free ephemeral port, then hand it to the web server. The
// tiny gap between close and re-bind is harmless for a local single-user app.
fn free_port() -> int {
    match (net.tcp_listen("127.0.0.1", 0)) {
        Result.Ok(l) => {
            let p = net.local_port(l);
            close(l);
            p
        },
        Result.Err(_) => 8737,
    }
}

fn main() -> int {
    let port = free_port();
    let url = "http://127.0.0.1:${port}/";

    let _server = spawn(fn() { let _r = web.listen(build, "127.0.0.1", port); });

    match (ui.open(APP_TITLE, url, WIN_W, WIN_H)) {
        Result.Ok(_win) => {},
        Result.Err(e) => {
            eprint("RayDesk: cannot open window: ${e}");
            return 1;
        }
    }

    while (true) {
        match (ui.next_event()) {
            Result.Ok(ev) => {
                if (ev.kind == "closed") { exit(0); }
            },
            Result.Err(e) => {
                eprint("RayDesk: ui event error: ${e}");
                exit(1);
            }
        }
    }
    0
}
